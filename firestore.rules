rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        (hasUserDoc() && getUserDoc().data.role == 'super_admin')
      );
    }

    function isUserAdmin(restaurantId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        ('role' in request.auth.token && request.auth.token.role == 'admin' && 'restaurantId' in request.auth.token && request.auth.token.restaurantId == restaurantId) ||
        (hasUserDoc() && getUserDoc().data.role == 'admin' && getUserDoc().data.restaurantId == restaurantId) ||
        (get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == uid())
      );
    }
    
    // Staff member check: requires super_admin, valid restaurant custom token claim, registered user profile, restaurant owner, or verified staff document
    function isStaffMember(restaurantId) {
       return isSignedIn() && (
         isSuperAdmin() || 
         ('restaurantId' in request.auth.token && request.auth.token.restaurantId == restaurantId) ||
         (hasUserDoc() && getUserDoc().data.restaurantId == restaurantId) ||
         (get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == uid()) ||
         exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(uid()))
       );
    }

    // Manager or Admin check: requires admin/manager custom token claim or registered user profile
    function isStaffManagerOrAdmin(restaurantId) {
      return isUserAdmin(restaurantId) || (
        isSignedIn() && (
          ('role' in request.auth.token && request.auth.token.role in ['admin', 'manager', 'super_admin'] && 'restaurantId' in request.auth.token && request.auth.token.restaurantId == restaurantId) ||
          (hasUserDoc() && getUserDoc().data.role in ['admin', 'manager', 'super_admin'] && getUserDoc().data.restaurantId == restaurantId)
        )
      );
    }

    function hasRestaurantRole(restaurantId, roles) {
      return isSignedIn() && (
        ('restaurantId' in request.auth.token && request.auth.token.restaurantId == restaurantId && 'role' in request.auth.token && request.auth.token.role in roles) ||
        (hasUserDoc() && getUserDoc().data.restaurantId == restaurantId && getUserDoc().data.role in roles)
      );
    }

    function canUpdateOperationalOrder(restaurantId) {
      return isStaffMember(restaurantId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'status', 'updatedAt', 'prepCompletedAt', 'completedAt', 'prepDuration', 'assignedWaiterId',
          'assignedWaiterName', 'tableId', 'tableName', 'servedAt', 'note',
          'kitchenNotes', 'inventoryDepleted', 'prepStartedAt', 'lastFiredAt',
          'lastFiredCourse'
        ]);
    }

    function canSettleOrder(restaurantId) {
      return hasRestaurantRole(restaurantId, ['cashier']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentMethod', 'paid', 'paidAt', 'updatedAt', 'splitPayments',
          'upiRef', 'terminalTx', 'rrn', 'authCode', 'terminalMethod', 'tipAmount',
          'giftCardCode', 'giftCardDeduction', 'settledChecks'
        ]);
    }


    // ─────────────────────────────────────────────
    // /users — admins can only read/write their own doc
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isSignedIn() && uid() == userId;
      // Protect user role creation and prevent claiming arbitrary restaurant IDs
      allow create: if isSignedIn() && uid() == userId && request.resource.data.role == 'admin' && (
        !('restaurantId' in request.resource.data) ||
        get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerUid == uid()
      );
      allow update: if isSignedIn() && uid() == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'restaurantId'])
      ) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─────────────────────────────────────────────
    // /restaurants
    // ─────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      // Public read — online order page needs restaurant name/logo
      // Sensitive subcollections like payroll, suppliers, void logs are isolated below
      allow read: if true;
      // Create — any signed-in user can register a new restaurant
      allow create: if isSignedIn();
      // Update/Delete — authenticated admin only (staff cannot mutate or delete restaurant document)
      allow update, delete: if isUserAdmin(restaurantId);

      // Staff profiles — public within restaurant (waiter assignment, order tagging, KDS)
      // Contains name, role, active, email. Does NOT contain sensitive credentials or compensation.
      match /staff/{staffId} {
        allow read:  if isStaffMember(restaurantId);
        allow write: if isUserAdmin(restaurantId);
      }

      // Staff Credentials & Compensation — strictly ADMIN ONLY
      // Stores plaintext PINs, salary rates, and overtime rates. Non-admin staff cannot read or write.
      match /staff_credentials/{staffId} {
        allow read, write: if isUserAdmin(restaurantId);
      }

      // Secrets & Private Credentials — strictly ADMIN ONLY
      // Stores sensitive secrets like email app passwords, payment terminal API keys.
      match /secrets/{secretId} {
        allow read, write: if isUserAdmin(restaurantId);
      }

      // Staff Single-Key PIN Authentication
      // Direct client get/list is strictly forbidden to prevent 4-digit brute-forcing.
      // Verification is performed server-side via the rate-limited validatePin Cloud Function.
      // Admins manage staff lookup records via StaffManager.
      match /staff_auth/{pin} {
        allow read, write: if isUserAdmin(restaurantId);
      }

      // PIN collection:
      // Direct client access is strictly denied to prevent 4-digit brute-forcing.
      // Verification is performed server-side via the rate-limited validatePin Cloud Function.
      match /pins/{pin} {
        allow read, write: if false;
      }

      // PIN verification rate limiter ledger — internal / Cloud Functions Admin SDK only
      match /_pin_attempts/{docId} {
        allow read, write: if false;
      }

      // Menu — public read, admin write only
      match /menu/{catId} {
        allow read:  if true;
        allow write: if isUserAdmin(restaurantId);
      }

      // Tables — public read, authenticated staff write (or customer claiming table on order)
      match /tables/{tableId} {
        allow read:  if true;
        allow write: if isStaffMember(restaurantId) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activeOrderId', 'currentOrderId']) &&
          request.resource.data.status in ['occupied', 'free']
        );
      }

      // Orders — public create (pending only with schema validation), staff read/update
      match /orders/{orderId} {
        allow get:    if isStaffMember(restaurantId);
        allow list:   if isStaffMember(restaurantId); // verified staff of this restaurant only
        allow create: if isStaffManagerOrAdmin(restaurantId) || hasRestaurantRole(restaurantId, ['cashier']) || (
          hasRestaurantRole(restaurantId, ['waiter']) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.total is number && request.resource.data.total >= 0 &&
          request.resource.data.items is list && request.resource.data.items.size() > 0
        ) || (
          request.resource.data.status == 'pending' &&
          request.resource.data.total is number && request.resource.data.total >= 0 &&
          request.resource.data.items is list && request.resource.data.items.size() > 0
        );
        allow update: if isStaffManagerOrAdmin(restaurantId) || hasRestaurantRole(restaurantId, ['cashier']) || canUpdateOperationalOrder(restaurantId) || canSettleOrder(restaurantId);
        allow delete: if false;                       // orders cannot be deleted; cancellation is status update
      }

      // Customer tracking exposes only the fields needed by the public order tracker.
      // Cloud Functions maintain this projection; clients cannot create or modify it.
      match /order_tracking/{orderId} {
        allow get: if true;
        allow list, create, update, delete: if false;
      }

      // Tokens — public read (TV display), authenticated staff write
      match /tokens/{date} {
        allow read:  if true;
        allow write: if isStaffMember(restaurantId);
      }

      // Slideshows & Posters — public read (TV display), admin write
      match /slideshows/{slideshowId} {
        allow read:  if true;
        allow write: if isUserAdmin(restaurantId);

        match /posters/{posterId} {
          allow read:  if true;
          allow write: if isUserAdmin(restaurantId);
        }
      }

      // Delivery Sync logs — read-only for authenticated, write via Cloud Functions only
      match /deliverySync/{platform}/logs/{logId} {
        allow read:  if isStaffMember(restaurantId);
        allow write: if false;
      }

      // Delivery Settings — authenticated admin read/write
      match /deliverySettings/{platform} {
        allow read, write: if isUserAdmin(restaurantId);
        match /{document=**} {
          allow read, write: if isUserAdmin(restaurantId);
        }
      }

      // Inventory — staff read/update stock, manager/admin full write
      match /inventory/{itemId} {
        allow read:           if isStaffMember(restaurantId);
        allow create, delete: if isStaffManagerOrAdmin(restaurantId);
        allow update:         if isStaffMember(restaurantId);
      }

      // Payroll — SENSITIVE: admin only
      match /payroll/{month}/entries/{staffEntryId} {
        allow read, write: if isUserAdmin(restaurantId);
      }

      // Customers CRM — authenticated staff read/write, deletion manager/admin only
      match /customers/{customerId} {
        allow read, create, update: if isStaffMember(restaurantId);
        allow delete:               if isStaffManagerOrAdmin(restaurantId);
      }

      // Reservations — authenticated staff read/write
      match /reservations/{reservationId} {
        allow read, write: if isStaffMember(restaurantId);
      }

      // Waitlist Queue — authenticated staff read/write
      match /waitlist/{waitlistId} {
        allow read, write: if isStaffMember(restaurantId);
      }

      // Suppliers Directory — staff read, admin write
      match /suppliers/{supplierId} {
        allow read:  if isStaffMember(restaurantId);
        allow write: if isUserAdmin(restaurantId);
      }

      // Purchase Orders — staff read, admin write
      match /purchase_orders/{poId} {
        allow read:  if isStaffMember(restaurantId);
        allow write: if isUserAdmin(restaurantId);
      }

      // Gift Cards & Vouchers — staff read, cashier can redeem (update balance), manager/admin create/delete
      match /gift_cards/{cardId} {
        allow read:           if isStaffMember(restaurantId);
        allow create, delete: if isStaffManagerOrAdmin(restaurantId);
        allow update:         if isStaffManagerOrAdmin(restaurantId) || (
          hasRestaurantRole(restaurantId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
        );
      }

      // Shifts & Drawer Tills — authenticated staff read/write, deletion forbidden
      match /shifts/{shiftId} {
        allow read: if isStaffManagerOrAdmin(restaurantId) || hasRestaurantRole(restaurantId, ['cashier']);
        allow create: if isStaffManagerOrAdmin(restaurantId) || hasRestaurantRole(restaurantId, ['cashier']);
        allow update: if isStaffManagerOrAdmin(restaurantId) || (
          hasRestaurantRole(restaurantId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closedAt', 'closedBy', 'closedById', 'closingCash', 'expectedCash',
            'cashDrops', 'paidOuts', 'cashSalesAmount', 'cashSalesCount', 'cardSalesAmount',
            'cardSalesCount', 'upiSalesAmount', 'upiSalesCount', 'totalSalesAmount',
            'actualCash', 'variance', 'updatedAt'
          ])
        );
        allow delete: if false;
      }

      // Void Audits Ledger — SENSITIVE: read admin-only, staff append-only, modification/deletion forbidden
      match /void_logs/{logId} {
        allow read: if isUserAdmin(restaurantId);
        allow create: if isStaffMember(restaurantId);
        allow update, delete: if false;
      }
    }
  }
}
